{
  "expo": {
    "name": "NetPulse Inspector",
    "slug": "netpulse-inspector",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "netpulse",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0b0f17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netpulse.inspector"
    },
    "android": {
      "package": "com.netpulse.inspector",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.QUERY_ALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
